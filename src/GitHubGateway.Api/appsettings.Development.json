{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "GitHub": {
    "Token": "",
    "ApiUrl": "https://api.github.com",
    "UserAgent": "GitHubGateway/1.0-dev",
    "CacheTtlSeconds": 10,
    "HttpTimeoutSeconds": 15
  },

  "IpWhitelist": {
    "Enabled": false,
    "AllowLocalhost": true,
    "Networks": [],
    "ApiKeys": []
  },

  "RateLimiting": {
    "Enabled": false,
    "PerIpLimit": 1000,
    "WindowSeconds": 60
  },

  "Audit": {
    "Enabled": true,
    "FilePath": "logs/audit-dev.jsonl",
    "WriteOnly": false
  }
}
